{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Two Snakes, One Box (Development)",
  "repo": "JaBoyAlex/two-snakes-one-box",
  "inputs": [
    {
      "id": "disc1",
      "label": "Twin Snakes USA revision 0 — Disc 1 (.rvz, .gcz, .iso, .gcm)",
      "role": "disc",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "iso",
            "gcm",
            "rvz",
            "gcz"
          ]
        }
      ],
      "check": {
        "ids": [
          "GGSEA4"
        ]
      }
    },
    {
      "id": "disc2",
      "label": "Twin Snakes USA revision 0 — Disc 2 (.rvz, .gcz, .iso, .gcm)",
      "role": "disc",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "iso",
            "gcm",
            "rvz",
            "gcz"
          ]
        }
      ],
      "check": {
        "ids": [
          "GGSEA4"
        ]
      }
    }
  ],
  "prepare": {
    "program": [
      "TwinSnakes.exe"
    ],
    "args": [
      "--prepare",
      "--disc1={input:disc1}",
      "--disc2={input:disc2}",
      "--data",
      "{data}"
    ],
    "label": "Validating both discs and building Twin Snakes locally",
    "done": [
      "{data}/prepared.json"
    ]
  },
  "start": {
    "program": [
      "TwinSnakes.exe"
    ],
    "args": [
      "--data",
      "{data}"
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{data}/user/config.ini"
        }
      ],
      "new": {
        "resolution": "640x528",
        "backend": "Vulkan",
        "show_fps_in_title": "true",
        "fullscreen": "auto"
      }
    },
    {
      "id": "graphics",
      "format": "ini",
      "file": [
        {
          "path": "{data}/user/Config/GFX.ini"
        }
      ]
    }
  ],
  "settings": [
    {
      "id": "display",
      "label": "Display",
      "group": "Video",
      "help": "Automatic opens in fullscreen from Big Picture and in a window from the desktop. Borderless fullscreen uses the monitor's desktop resolution.",
      "defaults": {
        "fullscreen": "auto"
      },
      "choices": [
        {
          "label": "Automatic",
          "set": {
            "fullscreen": "auto"
          }
        },
        {
          "label": "Window",
          "set": {
            "fullscreen": "false"
          }
        },
        {
          "label": "Borderless fullscreen",
          "set": {
            "fullscreen": "true"
          }
        }
      ]
    },
    {
      "id": "resolution",
      "label": "Internal resolution",
      "group": "Video",
      "help": "Choose a fixed GameCube render scale or let it follow the window size in whole steps.",
      "defaults": {
        "resolution": "640x528"
      },
      "choices": [
        {
          "label": "Original (1\u00d7)",
          "set": {
            "resolution": "640x528"
          }
        },
        {
          "label": "2\u00d7",
          "set": {
            "resolution": "1280x720"
          }
        },
        {
          "label": "3\u00d7",
          "set": {
            "resolution": "1920x1080"
          }
        },
        {
          "label": "4\u00d7",
          "set": {
            "resolution": "2560x1440"
          }
        },
        {
          "label": "6\u00d7",
          "set": {
            "resolution": "3840x2160"
          }
        },
        {
          "label": "Automatic integer scale",
          "set": {
            "resolution": "auto"
          }
        }
      ]
    },
    {
      "id": "backend",
      "label": "Graphics backend",
      "group": "Video",
      "defaults": {
        "backend": "Vulkan"
      },
      "choices": [
        {
          "label": "Vulkan",
          "set": {
            "backend": "Vulkan"
          }
        },
        {
          "label": "OpenGL",
          "set": {
            "backend": "OpenGL"
          }
        },
        {
          "label": "Direct3D 11",
          "set": {
            "backend": "D3D"
          }
        }
      ]
    },
    {
      "id": "photo_capture",
      "label": "Codec and Photo Album accuracy",
      "group": "Video",
      "in": "graphics",
      "advanced": true,
      "help": "Uses framebuffer copies to guest memory for the Codec backdrop and Photo Album. Restart the game after changing it.",
      "defaults": {
        "Hacks/XFBToTextureEnable": "False"
      },
      "choices": [
        {
          "label": "Off",
          "set": {
            "Hacks/XFBToTextureEnable": "True"
          }
        },
        {
          "label": "On",
          "set": {
            "Hacks/XFBToTextureEnable": "False"
          }
        }
      ]
    }
  ],
  "saves": [
    "{data}/user/GC",
    "{data}/user/Config",
    "{data}/user/config.ini"
  ],
  "folders": {
    "game": [
      {
        "path": "{data}/cache/builds"
      }
    ],
    "saves": [
      {
        "path": "{data}/user/GC"
      }
    ],
    "logs": [
      {
        "path": "{data}/logs"
      }
    ]
  },
  "exit_codes": {
    "20": "Missing, unsupported or mismatched discs. Choose Twin Snakes Disc 1 and Disc 2 from the same region and revision.",
    "21": "Setup dependency or filesystem error. See the local logs and development requirements.",
    "22": "Native compilation failed. See the local build log.",
    "24": "Twin Snakes is already running, or this installation is busy with setup.",
    "25": "The game runtime stopped with an error. This is a development build.",
    "27": "The local build is missing or damaged. Close this message and press Play again to reopen Easy Setup. Your saves and settings are kept."
  }
}
