-  m_fullscreen = false;
+}
+
+bool PlatformWin32::FitToMonitor(HMONITOR display)
+{
+  MONITORINFO monitor{};
+  monitor.cbSize = sizeof(monitor);
+  if (!GetMonitorInfo(display, &monitor))
+    return false;
+
+  const RECT& bounds = monitor.rcMonitor;
+  return SetWindowPos(m_hwnd, nullptr, bounds.left, bounds.top, bounds.right - bounds.left,
+                      bounds.bottom - bounds.top,
+                      SWP_NOZORDER | SWP_NOOWNERZORDER | SWP_FRAMECHANGED) != FALSE;
+}
+
+void PlatformWin32::ToggleFullscreen()
+{
+  if (IsWindowFullscreen())
+  {
+    RestoreWindowed();
+    return;
+  }
+
+  if (!GetWindowRect(m_hwnd, &m_windowed_rect))
+    return;
+
+  m_windowed_style = GetWindowLong(m_hwnd, GWL_STYLE);
+  m_windowed_ex_style = GetWindowLong(m_hwnd, GWL_EXSTYLE);
+  SetMenu(m_hwnd, nullptr);
+  SetWindowLong(m_hwnd, GWL_STYLE, m_windowed_style & ~WS_OVERLAPPEDWINDOW);
+  SetWindowLong(m_hwnd, GWL_EXSTYLE, m_windowed_ex_style & ~WS_EX_CLIENTEDGE);
+  m_window_fullscreen.store(true, std::memory_order_relaxed);
+  if (!FitToMonitor(MonitorFromWindow(m_hwnd, MONITOR_DEFAULTTONEAREST)))
+  {
+    RestoreWindowed();
+  }
 }
 
