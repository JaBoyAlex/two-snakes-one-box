+int SerialInterfaceManager::ToggleTwinSnakesControllerPort()
+{
+  if (Core::WantsDeterminism() || SConfig::GetInstance().GetGameID() != "GGSEA4")
+    return 0;
+
+  const int target = m_primary_controller_port == 0 ? 3 : 0;
+  if (m_desired_device_types[m_primary_controller_port] != SIDEVICE_GC_CONTROLLER ||
+      m_desired_device_types[target] != SIDEVICE_NONE)
+  {
+    return 0;
+  }
+
+  // Keep the same host mapping and hotplug behavior while moving the guest device.
+  Pad::ResetRumble(0);
+  ChangeDevice(SIDEVICE_NONE, m_primary_controller_port);
+  ChangeDevice(SIDEVICE_GC_CONTROLLER, target);
+  m_primary_controller_port = target;
+  return target + 1;
+}
+
+int SerialInterfaceManager::GetControllerInputIndex(int channel) const
+{
+  return channel == m_primary_controller_port ? 0 : channel;
+}
