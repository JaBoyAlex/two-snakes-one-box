+void PlatformWin32::ToggleControllerPort()
+{
+  auto& system = Core::System::GetInstance();
+  if (!Core::IsRunning(system))
+    return;
+
+  Core::RunOnCPUThread(system, [&system] {
+    if (!Core::IsRunning(system))
+      return;
+    const int port = system.GetSerialInterface().ToggleTwinSnakesControllerPort();
+    if (port == 0)
+    {
+      Core::DisplayMessage("Controller port switch unavailable", 2000);
+      return;
+    }
+
+    Core::DisplayMessage("Controller port " + std::to_string(port), 2000);
+    std::fprintf(stderr, "[input] Primary controller moved to port %d\n", port);
+  });
+}
