+
+bool StaticRecompCore::AllowsFallbackBlockLinking() const
+{
+  return m_module && !m_has_rel_modules && !m_guest.host_call &&
+         !m_module_source.host_call_contains && m_forced_fallback_ranges.empty();
+}
+
+bool StaticRecompCore::CanLinkFallbackTo(u32 address) const
+{
+  // A linked exit bypasses the core's dispatcher. Keep that boundary for
+  // every destination the native module could cover after verification.
+  return AllowsFallbackBlockLinking() &&
+         !AddressIsCovered(m_module->code_ranges, m_module->num_code_ranges, address);
 }
 
