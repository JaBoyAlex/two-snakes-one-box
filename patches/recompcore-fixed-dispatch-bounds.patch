@@ -140,6 +140,17 @@
 {
   return m_module && !m_has_rel_modules && !m_guest.host_call &&
          !m_module_source.host_call_contains;
+}
+
+StaticRecompRange StaticRecompCore::GetFixedNativeCodeBounds() const
+{
+  if (!AllowsFallbackBlockLinking())
+    return {};
+  const StaticRecompRange bounds{m_module->code_ranges[0].start,
+                                 m_module->code_ranges[m_module->num_code_ranges - 1].end};
+  if ((bounds.start | bounds.end) & 3u)
+    return {};
+  return bounds;
 }
 
