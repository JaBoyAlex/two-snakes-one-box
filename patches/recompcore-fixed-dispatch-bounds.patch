   FixupBranch static_recomp_exit;
   if (m_jit.IsStaticRecompFallback())
   {
+    // Fixed module ranges cannot change while these dispatcher routines are live.
+    // Addresses outside the bounds cannot yield to native code.
+    const StaticRecompRange bounds =
+        g_static_recomp_core ? g_static_recomp_core->GetFixedNativeCodeBounds() : StaticRecompRange{};
+    FixupBranch outside_native_bounds;
+    if (bounds.end > bounds.start)
+    {
+      MOV(32, R(RSCRATCH), PPCSTATE(pc));
+      SUB(32, R(RSCRATCH), Imm32(bounds.start));
+      CMP(32, R(RSCRATCH), Imm32(bounds.end - bounds.start));
+      outside_native_bounds = J_CC(CC_AE);
+    }
+
     ABI_PushRegistersAndAdjustStack({}, 0);
     MOV(32, R(ABI_PARAM1), PPCSTATE(pc));
     ABI_CallFunction(StaticRecompShouldYieldAt);
     ABI_PopRegistersAndAdjustStack({}, 0);
     TEST(32, R(ABI_RETURN), R(ABI_RETURN));
     static_recomp_exit = J_CC(CC_NZ, Jump::Near);
+    if (bounds.end > bounds.start)
+      SetJumpTarget(outside_native_bounds);
   }
 
