+
 void StaticRecompCore::SetPPCStateFromGuestState(const CPUState& s, PowerPC::PowerPCState& ppc)
 {
   std::memcpy(ppc.gpr, s.gpr, sizeof(ppc.gpr));
+#ifdef _M_X86_64
+  // Repack two registers at a time without interpreting the lane bits as floats.
+  for (int i = 0; i < 32; i += 2)
+  {
+    __m128i lane0, lane1;
+    std::memcpy(&lane0, &s.fpr[i], sizeof(lane0));
+    std::memcpy(&lane1, &s.ps1[i], sizeof(lane1));
+    const __m128i first = _mm_unpacklo_epi64(lane0, lane1);
+    const __m128i second = _mm_unpackhi_epi64(lane0, lane1);
+    std::memcpy(&ppc.ps[i], &first, sizeof(first));
+    std::memcpy(&ppc.ps[i + 1], &second, sizeof(second));
+  }
+#else
   for (int i = 0; i < 32; ++i)
   {
     std::memcpy(&ppc.ps[i].ps0, &s.fpr[i], sizeof(u64));
     std::memcpy(&ppc.ps[i].ps1, &s.ps1[i], sizeof(u64));
   }
+#endif
   ppc.pc = s.pc;
   ppc.npc = s.pc;
   ppc.spr[SPR_LR] = s.lr;
