+#ifdef _M_X86_64
+static u32 PackFourFields(const u64* fields)
+{
+  // Each field stores EQ in its low word. The sign, SO and LT are in the high word.
+  __m128i first, second;
+  std::memcpy(&first, fields, sizeof(first));
+  std::memcpy(&second, fields + 2, sizeof(second));
+  const auto low = _mm_castps_si128(
+      _mm_shuffle_ps(_mm_castsi128_ps(first), _mm_castsi128_ps(second), _MM_SHUFFLE(2, 0, 2, 0)));
+  const auto high = _mm_castps_si128(
+      _mm_shuffle_ps(_mm_castsi128_ps(first), _mm_castsi128_ps(second), _MM_SHUFFLE(3, 1, 3, 1)));
+  const auto zero = _mm_setzero_si128();
+  const auto equal = _mm_cmpeq_epi32(low, zero);
+  // GT is a signed 64-bit comparison. A zero high word is positive if the low word is nonzero.
+  const auto positive =
+      _mm_or_si128(_mm_cmpgt_epi32(high, zero), _mm_andnot_si128(equal, _mm_cmpeq_epi32(high, zero)));
+  const auto lt_so = _mm_and_si128(_mm_srli_epi32(high, CR_EMU_SO_BIT - 32),
+                                   _mm_set1_epi32(CR_LT | CR_SO));
+  const auto eq_gt = _mm_or_si128(_mm_and_si128(equal, _mm_set1_epi32(CR_EQ)),
+                                    _mm_and_si128(positive, _mm_set1_epi32(CR_GT)));
+  const auto nibbles = _mm_or_si128(lt_so, eq_gt);
+  const auto weighted = _mm_madd_epi16(nibbles, _mm_setr_epi32(0x1000, 0x0100, 0x0010, 0x0001));
+  const auto pairs = _mm_add_epi32(weighted, _mm_srli_si128(weighted, 8));
+  return static_cast<u32>(_mm_cvtsi128_si32(_mm_add_epi32(pairs, _mm_srli_si128(pairs, 4))));
+}
+#endif
+
 u32 ConditionRegister::Get() const
 {
+#ifdef _M_X86_64
+  return (PackFourFields(fields) << 16) | PackFourFields(fields + 4);
+#else
   u32 new_cr = 0;
   for (u32 i = 0; i < 8; i++)
   {
     new_cr |= GetField(i) << (28 - i * 4);
   }
   return new_cr;
+#endif
 }
 
