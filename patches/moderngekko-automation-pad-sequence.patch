+bool ParsePadSequence(const std::map<std::string, std::string>& values, Command* command,
+                      std::string* error)
+{
+  constexpr std::string_view prefix = "step.";
+  const auto port = values.find("port");
+  if (port == values.end())
+  {
+    if (error)
+      *error = "pad_sequence requires port=0..3";
+    return false;
+  }
+
+  std::map<std::uint32_t, std::map<std::string, std::string>> steps;
+  for (const auto& [key, value] : values)
+  {
+    if (key == "command" || key == "port")
+      continue;
+
+    const auto dot = key.find('.', prefix.size());
+    const auto number = key.starts_with(prefix) && dot != std::string::npos ?
+                            ParseUnsigned(std::string_view(key).substr(prefix.size(), dot - prefix.size())) :
+                            std::nullopt;
+    const auto field = dot == std::string::npos ? std::string{} : key.substr(dot + 1);
+    if (!number || *number == 0 || *number > 1024 ||
+        key.substr(prefix.size(), dot - prefix.size()) != std::to_string(*number) ||
+        (field != "fields" && !FindPadField(field)))
+    {
+      if (error)
+        *error = "invalid pad_sequence key: " + key;
+      return false;
+    }
+    steps[*number].emplace(field, value);
+  }
+
+  if (steps.empty() || steps.rbegin()->first != steps.size())
+  {
+    if (error)
+      *error = "pad_sequence steps must be numbered consecutively from 1";
+    return false;
+  }
+
+  std::uint32_t total = 0;
+  for (auto& [number, fields] : steps)
+  {
+    fields.emplace("port", port->second);
+    Command hold;
+    if (!ParsePadCommand(fields, &hold, "fields", error))
+    {
+      if (error)
+        *error = "pad_sequence step " + std::to_string(number) + ": " + *error;
+      return false;
+    }
+    total += hold.duration;
+    if (total > 36000)
+    {
+      if (error)
+        *error = "pad_sequence cannot exceed 36000 fields";
+      return false;
+    }
+    command->pad_sequence.push_back({hold.pad, hold.duration});
+  }
+  return true;
+}
