+const u8* StaticRecompCore::GetCodeBytes(u32 address, u32 length) const
+{
+  auto& memory = m_system.GetMemory();
+  const auto in_range = [length](u32 offset, u32 region_size) {
+    return offset < region_size && length <= region_size - offset;
+  };
+  if (in_range(address - 0x80000000u, m_lookup_ram_size))
+    return memory.GetRAM() + (address - 0x80000000u);
+  if (in_range(address - 0x90000000u, m_lookup_exram_size))
+    return memory.GetEXRAM() + (address - 0x90000000u);
+  if (in_range(address - FAKE_VMEM_BASE, m_lookup_fake_vmem_size))
+    return memory.GetFakeVMEM() + (address - FAKE_VMEM_BASE);
+  return nullptr;
+}
