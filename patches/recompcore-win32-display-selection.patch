+
+HMONITOR FindNamedMonitor(const std::string& selection)
+{
+  struct Search
+  {
+    std::wstring device;
+    HMONITOR match = nullptr;
+  };
+  Search search{L"\\\\.\\" + UTF8ToWString(selection)};
+  EnumDisplayMonitors(
+      nullptr, nullptr,
+      [](HMONITOR display, HDC, LPRECT, LPARAM data) -> BOOL {
+        auto& search = *reinterpret_cast<Search*>(data);
+        MONITORINFOEXW info{};
+        info.cbSize = sizeof(info);
+        if (!GetMonitorInfoW(display, &info) || search.device != info.szDevice)
+          return TRUE;
+        search.match = display;
+        return FALSE;
+      },
+      reinterpret_cast<LPARAM>(&search));
+  return search.match;
+}
+
