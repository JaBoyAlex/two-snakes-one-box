+void FifoManager::BeginStateTransfer()
+{
+  if (!m_system.IsDualCoreMode())
+    return;
+
+  SyncGPU(SyncGPUReason::Other);
+  m_state_transfer_in_progress.Set();
+  // Wait for an iteration that observes the pause. Video state callbacks still run on the
+  // GPU thread because async requests are serviced before it checks the pause flag.
+  m_gpu_mainloop.Wakeup();
+  m_gpu_mainloop.Wait();
+  m_gpu_mainloop.AllowSleep();
+}
+
+void FifoManager::EndStateTransfer()
+{
+  if (m_state_transfer_in_progress.TestAndClear() && m_emu_running_state.IsSet())
+    m_gpu_mainloop.Wakeup();
+}
