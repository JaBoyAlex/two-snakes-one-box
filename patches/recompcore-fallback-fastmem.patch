diff --git a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore.cpp b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore.cpp
index e3581cc938..24380413d1 100644
--- a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore.cpp
+++ b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompCore.cpp
@@ -194,10 +194,28 @@ void StaticRecompCore::Init()
   {
     m_fallback_jit->SetStaticRecompFallback(true);
     m_fallback_jit->Init();
+#ifdef _M_X86_64
+    // JitInterface uses the active core's arena flag to set the fallback's RAM base.
+    jo.fastmem_arena = m_fallback_jit->jo.fastmem_arena;
+#else
     m_fallback_jit->SetStaticRecompFallback(true);
+#endif
   }
 }
 
+#ifdef _M_X86_64
+bool StaticRecompCore::HandleFault(uintptr_t access_address, SContext* ctx)
+{
+  return m_fallback_jit && m_fallback_jit->jo.fastmem &&
+         m_fallback_jit->HandleFault(access_address, ctx);
+}
+
+bool StaticRecompCore::WantsPageTableMappings() const
+{
+  return m_fallback_jit && m_fallback_jit->WantsPageTableMappings();
+}
+#endif
+
 void StaticRecompCore::Shutdown()
 {
   g_static_recomp_core = nullptr;
