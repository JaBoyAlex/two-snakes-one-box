diff --git a/src/runtime/game.cpp b/src/runtime/game.cpp
--- a/src/runtime/game.cpp
+++ b/src/runtime/game.cpp
@@ -11,6 +11,12 @@
 #include <sstream>
 #include <vector>
 
+#ifdef _WIN32
+#include <limits>
+#include <windows.h>
+#include <bcrypt.h>
+#endif
+
 namespace moderngekko
 {
 namespace
@@ -23,6 +29,22 @@
   auto bytes = ReadFileBytes(path);
   if (!bytes)
     return std::nullopt;
+#if defined(_WIN32) && defined(BCRYPT_SHA256_ALG_HANDLE)
+  if (bytes->size() <= (std::numeric_limits<ULONG>::max)())
+  {
+    std::array<std::uint8_t, 32> digest{};
+    if (BCryptHash(BCRYPT_SHA256_ALG_HANDLE, nullptr, 0, bytes->data(),
+                   static_cast<ULONG>(bytes->size()), digest.data(),
+                   static_cast<ULONG>(digest.size())) == 0)
+    {
+      std::ostringstream hex;
+      hex << std::hex << std::setfill('0');
+      for (const auto value : digest)
+        hex << std::setw(2) << static_cast<unsigned int>(value);
+      return hex.str();
+    }
+  }
+#endif
   return Sha256(std::move(*bytes));
 }
 
